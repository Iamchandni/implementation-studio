{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://implementation-studio.local/schemas/artefact_envelope.schema.json",
  "title": "Common Artefact Envelope",
  "description": "Common metadata contract shared by all generated implementation artefacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artefact_id",
    "artefact_type",
    "name",
    "configuration",
    "source_requirements",
    "status",
    "version"
  ],
  "properties": {
    "artefact_id": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9-]+$"
    },
    "artefact_type": {
      "enum": [
        "PARAMETER",
        "BUSINESS_RULE",
        "VALIDATION",
        "WORKFLOW",
        "DATA_MAPPING",
        "INTEGRATION",
        "TEST_CASE"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "configuration": {
      "type": "object"
    },
    "source_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9-]+$"
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "VALIDATION_FAILED",
        "VALIDATED",
        "IN_REVIEW",
        "APPROVED",
        "REJECTED",
        "PUBLISHED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
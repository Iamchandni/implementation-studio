{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Artefact",
  "description": "Validation Artefact contract. Includes the common artefact envelope and a category-specific configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artefact_id",
    "artefact_type",
    "name",
    "configuration",
    "source_requirements",
    "status",
    "version"
  ],
  "properties": {
    "artefact_id": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9-]+$"
    },
    "artefact_type": {
      "const": "VALIDATION"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "data_type",
        "required"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "data_type": {
          "enum": [
            "STRING",
            "INTEGER",
            "NUMBER",
            "BOOLEAN",
            "DATE",
            "EMAIL",
            "PHONE",
            "CURRENCY"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "constraints": {
          "type": "object",
          "properties": {
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "min_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string"
            },
            "allowed_values": {
              "type": "array",
              "items": {}
            }
          },
          "additionalProperties": false
        },
        "error_message": {
          "type": "string"
        }
      }
    },
    "source_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9-]+$"
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "VALIDATION_FAILED",
        "VALIDATED",
        "IN_REVIEW",
        "APPROVED",
        "REJECTED",
        "PUBLISHED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}